{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flik.local/protocol/pair-request.schema.json",
  "title": "Flik Pair Request",
  "type": "object",
  "required": ["deviceId", "deviceName", "platform", "nonce"],
  "properties": {
    "deviceId": { "type": "string", "minLength": 1 },
    "deviceName": { "type": "string", "minLength": 1, "maxLength": 64 },
    "platform": { "enum": ["android", "windows"] },
    "nonce": { "type": "string", "minLength": 16 }
  },
  "additionalProperties": false
}
