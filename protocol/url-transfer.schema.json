  "$id": "https://flik.local/protocol/url-transfer.schema.json",
  "title": "Flik URL Transfer",
  "type": "object",
  "required": ["transferId", "url"],
  "properties": {
    "transferId": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "maxLength": 2048 },
