{
  "name": "flik-connector",
  "version": "1.0.0",
  "description": "Flik Connector for Windows 10/11",
  "author": "Flik Team",
  "main": "dist-electron/main/main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "electron dist-electron/main/main.js",
    "package:dir": "npm run build && electron-builder --win --dir",
    "package:dist": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "busboy": "^1.6.0",
    "check-disk-space": "^3.4.0",
    "electron-store": "^8.2.0",
    "express": "^4.21.1",
    "heic-convert": "^2.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^20.14.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
